@startuml qa_diagram
title Conceptual Model - Q&A Platform

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 90
hide empty members

' =========================================================
' 1. AUTHORSHIP AND USERS
' =========================================================
interface Author {
  + getDisplayName() : String
}

abstract class User {
  # email : String
  # passwordHash : String
  # displayName : String
  + getDisplayName() : String
  + postQuestion(title : String, body : String, category : Category, tags : Tag[*]) : Question
}

class RegularUser

class Moderator {
  + deletePost(p : Post) : void
}

class Administrator {
  + manageUsers() : void
}

class AIAgent {
  - displayName : String
  + getDisplayName() : String
}

Author <|.. User
Author <|.. AIAgent
User <|-- RegularUser
User <|-- Moderator
Moderator <|-- Administrator

' =========================================================
' 2. AUTHORSHIP FACTORY METHOD
' =========================================================
abstract class AuthorFactory {
  + {abstract} createAuthor() : Author
}

class HumanAuthorFactory {
  + createAuthor() : User
}

class AIAgentFactory {
  + createAuthor() : AIAgent
}

AuthorFactory <|-- HumanAuthorFactory
AuthorFactory <|-- AIAgentFactory

HumanAuthorFactory "0..*" -down-> "1" User : user
AIAgentFactory "0..*" -down-> "1" AIAgent : agent

' =========================================================
' 3. DOMAIN CONTENT
' =========================================================
abstract class Post {
  # body : String
  # publishedAt : DateTime
  + /score : int
  + upvote(voter : User) : void
  + downvote(voter : User) : void
}

class Question {
  - title : String
  + addAnswer(body : String, factory : AuthorFactory) : Answer
  + acceptAnswer(r : Answer, requester : User) : void
}

class Answer {
  - accepted : boolean
  + markAsAccepted() : void
}

class Vote {
  - date : DateTime
  - value : int
}

class Category {
  - name : String
}

class Tag {
  - name : String
}

Post <|-- Question
Post <|-- Answer

Question "1" *-right- "0..*" Answer : answers
Answer "0..*" -down-> "1" Author : author
Question "0..*" -up-> "1" Category : category
Question "0..*" -up-> "0..*" Tag : tags
Question "0..*" -down-> "1" User : author

Post "1" *-right- "0..*" Vote : votes
Vote "0..*" -down-> "1" User : voter

Question ..> AuthorFactory : <<use>>

' =========================================================
' 4. STRATEGY FOR LLM PROVIDERS
' =========================================================
interface LLMStrategy {
  + generate(prompt : String) : String
}

class OpenAIStrategy {
  - model : String
  + generate(prompt : String) : String
}

class GeminiStrategy {
  - model : String
  + generate(prompt : String) : String
}

class LocalModelStrategy {
  - model : String
  + generate(prompt : String) : String
}

OpenAIStrategy .down.|> LLMStrategy
GeminiStrategy .down.|> LLMStrategy
LocalModelStrategy .down.|> LLMStrategy

class AutoAnswerService {
  - maxTimeWithoutAnswer : Duration
  + setStrategy(e : LLMStrategy) : void
  + shouldAnswer(p : Question) : boolean
  + answer(p : Question) : Answer
}

AutoAnswerService "1" o-up-> "1" LLMStrategy : strategy
AutoAnswerService "0..*" -right-> "1" Tag : triggerTag
AutoAnswerService "0..*" -down-> "1" AIAgentFactory : factory
AutoAnswerService ..> Question : evaluates

' ---- layout (hidden links) ----
OpenAIStrategy -[hidden]right- GeminiStrategy
GeminiStrategy -[hidden]right- LocalModelStrategy
Tag -[hidden]right- Category
Category -[hidden]right- Post
AIAgentFactory -[hidden]right- HumanAuthorFactory
AIAgent -[hidden]right- User
AIAgentFactory -[hidden]down- AIAgent
Answer -[hidden]right- Vote


' =========================================================
' NOTES (in a legend so they do not interfere with the layout)
' =========================================================
legend bottom
  |= Element |= Design decisions and business rules |
  | **Question** | Only a human User can create a Question.\nOnly the author of the Question can accept answers (acceptAnswer receives the requester).\nThere can be several accepted answers.\nBelongs to one Category and has 0..* Tags.\naddAnswer() receives an AuthorFactory, gets the Author with createAuthor() and creates the Answer;\nQuestion does not know whether the author is human or AI. |
  | **Answer** | Only knows the Author interface: it is agnostic to whether a human or an AIAgent wrote it. |
  | **Post / Vote** | Only a registered User can cast votes.\nVote is a separate class: a User can cast only one Vote per Post.\nscore is derived (sum of the Vote values, +1 / -1). |
  | **Automatic answer** | 1. Checks whether the Question has the trigger Tag ("ia-help") or the time without answers has expired.\n2. Uses LLMStrategy.generate(prompt) to get the text.\n3. Calls Question.addAnswer(text, aiAgentFactory).\nThe AIAgent is pre-registered: the AIAgentFactory returns it, a new one is not created for each answer.\nThe strategy is interchangeable and stays decoupled from the domain. |
endlegend

@enduml
