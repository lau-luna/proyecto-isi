# Copiá este archivo a .env y completá los valores. .env NO se versiona.

# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame

# Solo la lee ProductionConfig. Desarrollo usa SQLite en /tmp/foo.db (hardcodeado)
# y testing usa SQLite en memoria.
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/proyecto
